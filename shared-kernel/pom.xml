<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<!-- Liên kết tới Parent POM ở thư mục ngoài cùng -->
	<parent>
		<groupId>com.template</groupId>
		<artifactId>backend-api</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>

	<artifactId>shared-kernel</artifactId>
	<name>shared-kernel</name>
	<description>Shared Kernel (Common configuration & libraries)</description>

	<!-- Không cần <properties><java.version>21</java.version></properties> vì kế thừa từ Parent -->

	<dependencies>
		<!-- Dùng để viết BaseEntity (ví dụ có các trường chung như createdAt, updatedAt) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Dùng để viết SecurityConfig chung, JWT Filter, và xác thực quyền -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Dùng để viết GlobalExceptionHandler, RequestInterceptor, v.v. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		
		<!-- Test Dependencies -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!-- ĐÃ XÓA <build><plugins><spring-boot-maven-plugin> 
	     vì shared-kernel là thư viện dùng chung, không phải file chạy (executable jar) -->

</project>
